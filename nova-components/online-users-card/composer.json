{
    "name": "kurozora/online-users-card",
    "description": "Nova dashboard card showing the live count of users with an active WebSocket presence.",
    "type": "library",
    "require": {
        "php": "^8.4",
        "laravel/nova": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Kurozora\\OnlineUsersCard\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kurozora\\OnlineUsersCard\\CardServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
